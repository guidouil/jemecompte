# Local PostgreSQL only. Set independent credentials in production.
# A linked Clever Cloud PostgreSQL add-on can supply POSTGRESQL_ADDON_URI instead.
DATABASE_URL=postgres://jemecompte:jemecompte_local@127.0.0.1:55439/jemecompte
TEST_DATABASE_URL=postgres://jemecompte:jemecompte_local@127.0.0.1:55439/jemecompte_test
ORIGIN=http://127.0.0.1:5173
COUNTER_EPOCH=1
# Enable only after the real pilot's privacy/legal decisions and operational checks.
REAL_EVENTS_APPROVED=false
HOST=127.0.0.1
PORT=3000
BODY_SIZE_LIMIT=2K
